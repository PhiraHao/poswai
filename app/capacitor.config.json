{
  "appId": "com.zzaxstudio.poswai",
  "appName": "POS WAI",
  "webDir": "www",
  "server": {
    "url": "https://poswai.zzaxstudio.com",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "poswai.zzaxstudio.com",
      "accounts.google.com",
      "*.google.com",
      "access.line.me",
      "*.line.me"
    ]
  },
  "plugins": {
    "BluetoothLe": {
      "displayStrings": {
        "scanning": "กำลังค้นหาเครื่องพิมพ์",
        "cancel": "ยกเลิก",
        "availableDevices": "เครื่องพิมพ์ที่เจอ",
        "noDeviceFound": "ไม่เจอเครื่องพิมพ์"
      }
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#141b24"
    }
  },
  "ios": {
    "contentInset": "always"
  },
  "android": {
    "allowMixedContent": false
  }
}
